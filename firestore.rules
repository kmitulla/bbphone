// ===========================================================
// Firestore-Sicherheitsregeln für das Babyphone
// -----------------------------------------------------------
// Nur ANGEMELDETE Nutzer dürfen Räume, die Raumliste,
// Verbindungsdaten und Einstellungen lesen/schreiben.
// ===========================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Das Raum-Dokument selbst (für die Raumliste + Fernsteuerung):
    match /rooms/{room} {
      allow read, write: if request.auth != null;

      // Alles darunter (Verbindungen, ICE-Kandidaten):
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Sicherheitsnetz: alles andere ist verboten.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
